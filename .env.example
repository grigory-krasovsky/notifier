# Copy to .env (git-ignored) and fill in.
# Wire it up via an IntelliJ run configuration (EnvFile plugin or manual env vars),
# or later via `docker compose` env_file.
TELEGRAM_BOT_TOKEN=

# Optional proxy for Telegram traffic (SOCKS or HTTP). From Docker use host.docker.internal
# to reach a proxy listening on the host.
#TELEGRAM_PROXY_HOST=host.docker.internal
#TELEGRAM_PROXY_PORT=1080
#TELEGRAM_PROXY_TYPE=SOCKS

# Local DB overrides - defaults already match docker-compose.yml, uncomment only to change
#DB_URL=jdbc:postgresql://localhost:5432/notifier
#DB_USERNAME=notifier
#DB_PASSWORD=notifier
